# Local development API base URL. `npm run build` uses frontend/.env.production
# (same-origin /api) instead, so a local production build never calls localhost.
# Override .env.production only for split hosting.
REACT_APP_API_URL=http://localhost:5000/api
# Razorpay public key (safe to expose; must match backend RAZORPAY_KEY_ID)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Google Sign-In client ID (must match backend GOOGLE_CLIENT_ID).
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Google Analytics 4 (optional; unset = silent no-op).
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta Pixel (optional; same pattern as GA).
# REACT_APP_META_PIXEL_ID=1234567890
