# API base URL the browser calls.
# - Single-service deployment (backend serves the build): set to https://your-domain.com/api
#   or leave the default-relative value if proxying.
# - Separate hosting (e.g. Vercel frontend + Render backend): https://your-backend.onrender.com/api
REACT_APP_API_URL=http://localhost:5000/api
# Razorpay public key (test key, safe to expose; must match backend RAZORPAY_KEY_ID)
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# Google Sign-In client ID (from https://console.cloud.google.com/apis/credentials)
# Must match the backend GOOGLE_CLIENT_ID.
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Explicit test-payment UI (P1-7). When "true" (dev/staging ONLY), the payment
# screen offers a clearly-labelled TEST payment button after a 503 from the
# gateway. NEVER set to "true" in a production build — production shows an
# honest "unavailable, no money charged" error instead.
# REACT_APP_ALLOW_TEST_PAYMENTS=false
# Google Analytics 4 (optional — when set, the app loads gtag.js and fires
# page_view + funnel events; when unset, analytics is a silent no-op).
# REACT_APP_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Meta Pixel (optional — same pattern, fires trackCustom with the same events).
# REACT_APP_META_PIXEL_ID=1234567890
