  "findings": [
    {
      "id": "EVT-AUD-001",
      "severity": "P1",
      "status": "OPEN",
      "title": "Pricing update persists successfully but returns HTTP 500",
      "location": "backend/controllers/eventPricingController.js:3-7, :241",
      "evidence": {
        "request": "PUT /api/event-pricing (admin)",
        "updateStatus": 500,
        "persistedValue": 123,
        "responseMessage": "getPricingTable is not defined"
      },
      "impact": "Admins receive a failure after the change is saved; retries can cause version conflicts. Pricing API contract is broken.",
      "recommendation": "Import getPricingTable from utils/eventPricing or return the saved/normalized document. Add regression asserting 200 and a subsequent quote using the new price."
    },
    {
      "id": "EVT-AUD-002",
      "severity": "P1",
      "status": "OPEN",
      "title": "Partial pricing edit corrupts nested servicePrices and blocks valid bookings",
      "location": "backend/utils/eventPricing.js:39-65",
      "evidence": {
        "partialCreateConfiguredKeys": "cooking_only.upto2 only",
        "quoteStatus": 400,
        "quoteMessage": "No price configured for this service and duration",
        "bookingStatus": 400,
        "bookingMessage": "No price configured for this service and duration"
      },
      "impact": "A valid admin edit can silently remove prices for other durations/services, breaking quotes and new bookings.",
      "recommendation": "Deep-merge each service duration map, require complete tables on create/update or merge with current, validate every service/duration key, backfill existing documents, and add quote/booking regression tests."
    },
    {
      "id": "EVT-AUD-003",
      "severity": "P2",
      "status": "OPEN",
      "title": "Status PATCH can set cook_assigned with no cook",
      "location": "backend/controllers/eventBookingController.js (updateEventBookingStatus)",
      "evidence": {
        "request": "PATCH /api/event-bookings/:id/status { status: 'cook_assigned' }",
        "status": 200,
        "bookingStatus": "cook_assigned",
        "cookId": null
      },
      "impact": "Bypasses cook eligibility and overlap checks; downstream state can show an assigned booking without a cook.",
      "recommendation": "Require a valid cookId for cook_assigned, or reject manual transitions to that state and require the assign-cook endpoint."
    },
    {
      "id": "EVT-AUD-004",
      "severity": "P2",
      "status": "OPEN_POLICY_DECISION",
      "title": "Paid in-progress cancellation queues no refund",
      "location": "backend/controllers/eventBookingController.js (cancellation path); docs/EVENT_POLICY_APPROVAL.md",
      "evidence": {
        "request": "cancel paid in_progress booking",
        "status": 200,
        "bookingState": "cancelled",
        "paymentStatus": "paid",
        "refundStatus": "none"
      },
      "impact": "Customer funds may be retained without an auditable refund or explicit policy basis.",
      "recommendation": "Decide policy, then either block paid in-progress cancellation or enqueue a refund with ledger entry. Add payment/refund regression test."
    },
    {
      "id": "EVT-AUD-005",
      "severity": "P2",
      "status": "OPEN",
      "title": "Existing frontend build targets http://localhost:5000/api",
      "location": "frontend/.env; frontend/build/static/js/main.e9d57d9d.js",
      "evidence": {
        "originalBuildContains": "http://localhost:5000/api",
        "browserOnIsolatedPort": "All API calls blocked/unreachable until rebuilt with REACT_APP_API_URL=/api",
        "csp": "connect-src 'self' ... blocks cross-origin localhost"
      },
      "impact": "Deploying the current artifact breaks API calls and authentication. Local .env also bakes the live Razorpay public key into the build.",
      "recommendation": "Rebuild in CI with production same-origin /api, use environment-appropriate public keys, and reject localhost URLs in shipped JS."
    },
    {
      "id": "EVT-AUD-006",
      "severity": "P2",
      "status": "OPEN_DESIGN_RISK",
      "title": "Pricing DB errors silently fall back to launch defaults",
      "location": "backend/utils/eventPricing.js:71-89",
      "evidence": {
        "codeReview": "findOne failures are swallowed; normalizePricing(null) returns launch defaults with version 0"
      },
      "impact": "During a DB outage, quotes can silently use stale/default prices and version 0, potentially allowing bookings at unconfigured prices.",
      "recommendation": "Fail closed for booking/payment (503 PRICING_UNAVAILABLE) or mark quotes provisional, emit metrics/alerts, and add fault-injection coverage."
    },
    {
      "id": "EVT-AUD-007",
      "severity": "P3",
      "status": "CODE_REVIEW",
      "title": "Idempotency fingerprint is case-sensitive",
      "location": "Events booking idempotency handling",
      "evidence": {
        "codeReview": "Payload differences in letter case produce 409 IDEMPOTENCY_KEY_REUSED instead of replaying the original request"
      },
      "impact": "Low: semantically identical retries can be reported as conflicts.",
      "recommendation": "Normalize fingerprints (trim, lowercase canonical fields) before hashing and add a replay test."
    },
    {
      "id": "EVT-AUD-008",
      "severity": "P3",
