
# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MongoDB Atlas) ----
# Paste your Atlas SRV connection string here. Atlas → Database → Connect →
# Drivers → copy the string, then replace <db_username>, <db_password> and
# (optionally) add the database name after .net/, e.g.:
# mongodb+srv://myuser:mypassword@festivecook.xxxxx.mongodb.net/festivecook?retryWrites=true&w=majority
# Notes:
# - URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, ? → %3F, # → %23).
# - Atlas → Network Access must allow your IP (0.0.0.0/0 for hosted platforms).
# - Local dev alternative (offline): mongodb://localhost:27017/festivecook
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/festivecook?retryWrites=true&w=majority
# Optional tuning (defaults are Atlas-friendly, change only if needed):
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# Max connections per API instance. Default 50 (raised from 10 so a traffic
# spike doesn't queue behind a tiny pool). Keep it within your Atlas tier's
# connection limit x number of instances.
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=1
# MONGO_RETRY_MS=5000

# ---- Traffic / abuse limits (per instance, rolling windows) ----
# Every /api/* request passes RATE_LIMIT_GENERAL per minute per IP; login and
# password-reset get their own longer window; payments get a strict bucket.
# Tune down for a small launch, up when real traffic grows.
# RATE_LIMIT_GENERAL=300   # per minute, per IP (all /api/*)
# RATE_LIMIT_AUTH=100      # per 15 min, per IP (/api/auth/*)
# RATE_LIMIT_STRICT=30     # per 15 min, per IP (/api/payments/*)
# RATE_LIMIT_VISIT=120     # per minute, per IP (visit ping)

# ---- Shared rate-limit store (needed with 2+ API instances) ----
# Counters are per-process by default, so every extra replica multiplies the
# effective limit (3 instances → 900/min instead of 300/min). The buckets listed
# here are backed by a small MongoDB collection instead, so their limits stay
# exact across the whole fleet. No Redis, no extra service to run.
# Default "auth,strict" covers the security-critical, low-traffic buckets only:
# /api/* runs at up to ~1000 req/s, and a database write per request would cost
# far more than the coarse per-instance dampener it replaces.
#   RATE_LIMIT_SHARED=auth,strict   # default
#   RATE_LIMIT_SHARED=all           # every bucket shares counters (heavy)
#   RATE_LIMIT_SHARED=              # fully in-memory (single instance)
# A database outage degrades to in-memory limits — requests never fail because
# the store is down (see utils/rateLimitStore.js).
# RATE_LIMIT_SHARED=auth,strict

# ---- Auth ----
# Long random string (64+ hex chars). NEVER reuse dev values in production.
# Generate/rotate with:  node backend/scripts/rotate-secrets.js --write backend/.env
# A previously committed JWT_SECRET must be treated as COMPROMISED: rotate it
# in every environment and purge it from git history (see docs/SECRET_ROTATION.md).
JWT_SECRET=your_jwt_secret_here

# ---- Business timezone ----
# All booking math is anchored to Asia/Kolkata in code, but the process TZ is
# pinned here as defense-in-depth so server-local Date calls agree with IST.
TZ=Asia/Kolkata

# ---- Upload storage (verification documents) ----
# Local directory for cook verification docs. MUST point at a persistent volume
# in production (Render disk / mounted volume) — ephemeral container disks are
# wiped on redeploy and uploaded ID documents would be LOST. For multi-instance
# or zero-loss durability use S3/R2 (see docs/UPLOAD_STORAGE.md).
# UPLOAD_DIR=/data/cookmitra-uploads

# ---- CORS / frontend origin ----
# Where the frontend is served from. Comma-separate multiple origins if needed.
# Leave empty when frontend + backend are deployed together (same origin).
# CLIENT_URL=https://your-frontend.example.com

# ---- Razorpay (live keys from https://dashboard.razorpay.com/app/keys) ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR
# Webhook secret (Dashboard → Settings → Webhooks → your endpoint secret).
# Required to verify POST /api/payments/webhook (payment.captured reconcile).
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# Dev-only simulated checkout (NO real money). MUST be "false"/unset in production
# (the server refuses to start in production when this is "true").
# ALLOW_TEST_PAYMENTS=false
# Refuse to boot in production without live Razorpay keys. Recommended "true"
# for any deployment that takes real payments; "false" only when online payment
# is intentionally disabled (bookings then stay unpaid until enabled).
# REQUIRE_PAYMENTS=false
# Short-lived signed document view URLs (P0-2, ms; clamped to 30s–15min).
# DOC_URL_TTL_MS=300000

# ---- Google Sign-In (from https://console.cloud.google.com/apis/credentials) ----
# Must match the frontend REACT_APP_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# ---- Password-reset email (optional) ----
# Without these, POST /auth/forgot-password still works but cannot email the
# link: in development the token is returned in the API response for testing,
# in production the user sees a generic message (configure SMTP to go live).
# Needs `npm i nodemailer` in backend/.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password_here
# SMTP_FROM=CookMitra <you@example.com>
# Frontend origin used to build the emailed reset link (defaults to CLIENT_URL).
# FRONTEND_BASE_URL=https://your-frontend.example.com
