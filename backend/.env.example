# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas SRV string; URL-encode special chars in the password).
# e.g.: mongodb+srv://myuser:mypassword@festivecook.xxxxx.mongodb.net/festivecook?retryWrites=true&w=majority
# Allow your IP in Atlas → Network Access (0.0.0.0/0 for hosted platforms).
# Local offline alternative: mongodb://localhost:27017/festivecook
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/festivecook?retryWrites=true&w=majority
# Optional tuning (defaults are Atlas-friendly):
# MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
# Max connections per instance (default 50; keep within Atlas tier limit x instances).
# MONGO_MAX_POOL_SIZE=50
# MONGO_MIN_POOL_SIZE=1
# MONGO_RETRY_MS=5000

# Rate limits (per instance, rolling windows).
# RATE_LIMIT_GENERAL=300   # per minute, per IP (all /api/*)
# RATE_LIMIT_AUTH=100      # per 15 min, per IP (/api/auth/*)
# RATE_LIMIT_STRICT=30     # per 15 min, per IP (/api/payments/*)
# RATE_LIMIT_VISIT=120     # per minute, per IP (visit ping)

# Shared rate-limit store (exact limits with 2+ instances; default "auth,strict,otp").
# A DB outage degrades to in-memory limits (see utils/rateLimitStore.js).
#   RATE_LIMIT_SHARED=auth,strict,otp   # default
#   RATE_LIMIT_SHARED=all           # every bucket shared (heavy)
#   RATE_LIMIT_SHARED=              # fully in-memory (single instance)
# RATE_LIMIT_SHARED=auth,strict,otp

# Auth (long random 64+ hex chars; never reuse dev values in production).
# Generate/rotate: node backend/scripts/rotate-secrets.js --write backend/.env
JWT_SECRET=your_jwt_secret_here

# Business timezone (booking math is IST-anchored in code; pinned as backstop).
TZ=Asia/Kolkata

# Upload storage (cook verification docs; must be a persistent volume in production).
# UPLOAD_DIR=/data/cookmitra-uploads

# CORS / frontend origin (comma-separated; leave empty for same-origin deploys).
# CLIENT_URL=https://your-frontend.example.com

# Razorpay (live keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_CURRENCY=INR
# Webhook secret (Dashboard → Settings → Webhooks).
# RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
# Refuse production boot without live keys + webhook secret (recommended "true" for real payments).
# REQUIRE_PAYMENTS=false
# Signed doc view URL TTL (ms; clamped 30s–15min).
# DOC_URL_TTL_MS=300000

# Google Sign-In (must match frontend REACT_APP_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# WhatsApp notifications (Meta Cloud API, see docs/WHATSAPP_SETUP.md).
# Without these only the automatic push is skipped (in-app + wa.me links stay).
# WHATSAPP_ENABLED=true
# WHATSAPP_TOKEN=your_permanent_system_user_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# WHATSAPP_API_VERSION=v22.0
# Inbound webhook (cook Accept/Decline from WhatsApp):
# WHATSAPP_APP_SECRET=your_meta_app_secret_here
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=a_long_random_string_you_invent
# (WHATSAPP_VERIFY_TOKEN is also honored as an alias — same value Meta holds)
# Cold-start template (outside the 24h window Meta only delivers templates).
# Canonical names (also honored by utils/whatsappApi.js):
# WHATSAPP_REQUEST_TEMPLATE=cook_booking_request
# WHATSAPP_REQUEST_TEMPLATE_LANG=en
# Legacy aliases still honored (existing .env files may use these):
# WHATSAPP_REQUEST_TEMPLATE_FOR_COOK=cook_booking_request
# WHATSAPP_TEMPLATE_LANG_COOK_REQUEST=en

# Password-reset email (required for live "forgot password" delivery).
# Without these: dev returns the token in the API response; production sends nothing.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password_here
# SMTP_FROM=CookMitra <you@example.com>
# Refuse production boot without mail delivery (recommended once SMTP works).
# REQUIRE_SMTP=false
# Reset-link origin (defaults to CLIENT_URL).
# FRONTEND_BASE_URL=https://your-frontend.example.com
